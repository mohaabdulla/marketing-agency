# Cloudflare Workers AI free daily allowance. Restart the server after edits.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_MODEL=cf:flux-schnell
# After isolated local setup is verified, it is selected automatically unless IMAGE_MODEL is set.
# IMAGE_MODEL=local:segmind-vega

# Open weights: hosted computation may require credits.
HF_TOKEN=
HF_PROVIDER=auto
IMAGE_PROVIDER=huggingface
# IMAGE_MODEL=hf:Tongyi-MAI/Z-Image-Turbo
# IMAGE_MODEL=hf:Qwen/Qwen-Image-2512
# IMAGE_MODEL=hf:black-forest-labs/FLUX.1-schnell
# Local CUDA inference: install requirements-local.txt, pre-download weights.
# IMAGE_PROVIDER=local
# Explicit opt-in for multi-GB model downloads:
ALLOW_MODEL_DOWNLOAD=0

# Optional secret key (sk_...) from https://enter.pollinations.ai/keys
# Provider model availability and quota apply; no guaranteed free unlimited API.
# Also used for copywriting when no Gemini key is set.
POLLINATIONS_API_KEY=

# Optional, free from https://aistudio.google.com/apikey
# Enables grounded research + copywriting. Image quota is separate.
GEMINI_API_KEY=

# Optional overrides
# TEXT_MODEL=openai/gpt-5.4-mini
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
