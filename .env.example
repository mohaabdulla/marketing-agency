# Cloudflare Workers AI free daily allowance. Restart the server after edits.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_MODEL=cf:flux-schnell
# After isolated local setup is verified, it is selected automatically unless IMAGE_MODEL is set.
# IMAGE_MODEL=local:segmind-vega
# Higher quality photographic model, after download and verification:
# IMAGE_MODEL=local:realvisxl-v5

# Open weights: hosted computation may require credits.
HF_TOKEN=
HF_PROVIDER=auto
IMAGE_PROVIDER=huggingface
# IMAGE_MODEL=hf:Tongyi-MAI/Z-Image-Turbo
# IMAGE_MODEL=hf:Qwen/Qwen-Image-2512
# IMAGE_MODEL=hf:black-forest-labs/FLUX.1-schnell
# Local CUDA inference: install requirements-local.txt, pre-download weights.
# IMAGE_PROVIDER=local
# Explicit opt-in for multi-GB model downloads:
ALLOW_MODEL_DOWNLOAD=0

# Optional secret key (sk_...) from https://enter.pollinations.ai/keys
# Provider model availability and quota apply; no guaranteed free unlimited API.
# Also used for copywriting when no Gemini key is set.
POLLINATIONS_API_KEY=

# Optional, free from https://aistudio.google.com/apikey
# Enables grounded research + copywriting. Image quota is separate.
GEMINI_API_KEY=

# Optional overrides
# TEXT_MODEL=openai/gpt-5.4-mini
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Video Studio: local processing only. No AI weight downloads at startup.
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/ffmpeg/bin/ffprobe.exe
# VIDEO_DATA_DIR=output/video
VIDEO_MAX_UPLOAD_MB=256
VIDEO_DISK_QUOTA_GB=8
# Cross-origin browser clients must be explicitly listed; same-origin always works.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
VIDEO_ALLOWED_ORIGINS=
# Optional video environment: .venv-video; models: .model-cache/video.
# See VIDEO_STUDIO.md for explicit setup commands and hardware gates.

# Agency planning is single-operator and loopback-only; no hosted AI dependency.
# AGENCY_DATA_DIR=output/agency
# Online research is opt-in, allowlisted by exact hostname, one page per capture.
AGENCY_WEB_RESEARCH=0
AGENCY_RESEARCH_ALLOWED_DOMAINS=
AGENCY_RESEARCH_BLOCKED_DOMAINS=
# Optional trusted CA bundle; TLS verification cannot be disabled.
# AGENCY_RESEARCH_CA_BUNDLE=C:/certificates/trusted-research-roots.pem
# Optional externally managed CPU llama.cpp server; no API key or hosted fallback.
# LOCAL_TEXT_URL=http://127.0.0.1:8081
LOCAL_TEXT_MODEL=lexnis-qwen3-4b
# Optional local Whisper/CTranslate2 weights. Never downloaded at startup; see ACQUISITION_AND_AUDIO.md.
# AGENCY_ASR_MODEL_DIR=C:/models/your-reviewed-whisper-model
